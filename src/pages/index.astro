---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

const weeks = [
  ["1", "Decisions Leave Traces", "Reading agendas, minutes and emails as evidence, not narrative.", "01-getting-started", "week-01"],
  ["2", "Who Gets Invited?", "Invitation lists as the first, quietest decision in any process.", "02-first-review", "week-02"],
  ["3", "The Agenda Is an Argument", "How naming, ordering and timing argue for an outcome.", "03-the-agenda-is-an-argument", "week-03"],
  ["4", "The Meeting Before the Meeting", "Where a decision may already be forming before the room, and how you'd tell — from the record, not from suspicion.", "04-the-meeting-before-the-meeting", "week-04"],
  ["5", "Information Arrives on Someone's Schedule", "Timing as a lever some people control and others don't — not automatically a manipulation.", "05-information-arrives-on-someones-schedule", "week-05"],
  ["6", "Silence Is a Position — Sometimes", "Reading what a record omits, and the several different things an abstention can mean.", "06-silence-is-a-position-sometimes", "week-06"],
  ["7", "Power in the Room", "Formal authority versus who the room actually defers to, and how you'd distinguish the two from a transcript.", "07-power-in-the-room", "week-07"],
  ["8", "Dissent Without Disappearing", "Registering disagreement in a record that survives it.", "08-dissent-without-disappearing", "week-08"],
  ["9", "Who Actually Decides", "Decision rights, sign-off chains, and the difference between holding a veto and using one.", "09-who-actually-decides", "week-09"],
  ["10", "Minutes Make Memory", "How the written record becomes the decision, regardless of the room.", "10-minutes-make-memory", "week-10"],
  ["11", "The Ethics of Alignment", "What a fair process owes the people it is run on.", "11-the-ethics-of-alignment", "week-11"],
  ["12", "Redesigning the Decision", "Turning a diagnosis into a process someone else could run.", "12-redesigning-the-decision", "week-12"],
];
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Read real, publicly documented decisions the way an investigator reads a
    paper trail — for what an agenda's wording assumes, what an invitation
    list omits, and what a set of minutes was written to make true. Then
    you'll run a decision yourself: a live, four-role negotiation over a
    fictional workplace proposal, played once and audited afterwards for what
    actually decided the outcome. The course follows one running fictional
    case, the Engagement Signal Pilot at Slop University, from its first
    announcement through to the decision that follows from it.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who is about to spend a career sitting in meetings and would
    rather understand how they actually work. No prior study of
    organisations, ethics or politics is assumed — the course teaches its own
    vocabulary from Week 1. What it does assume is a willingness to argue a
    position you may not personally hold, and to have that argument examined
    afterwards for the judgement and evidence behind it — never for how
    persuasive or confident you sounded while making it.
  </p>

  <h2>The twelve weeks</h2>
  <table class="week-table">
    <thead>
      <tr>
        <th scope="col">Week</th>
        <th scope="col">Topic</th>
        <th scope="col">What it covers</th>
      </tr>
    </thead>
    <tbody>
      {
        weeks.map(([n, title, blurb, sessionSlug, lectureSlug]) => (
          <tr>
            <td>{n}</td>
            <td>
              <a href={withBase(`/sessions/${sessionSlug}/`)}>{title}</a>
            </td>
            <td>
              {blurb}{" "}
              <a href={withBase(`/lectures/${lectureSlug}/`)}>lecture</a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="week-table-note">
    All twelve weeks run the same way: a session page carries that week's
    case documents and in-class exercise, and its paired lecture carries the
    conceptual reading and links back to the session for the full text.
    Weeks 1 and 3 additionally have a slide deck each — see the{" "}
    <a href={withBase("/lectures/week-01/")}>Week 1</a> and{" "}
    <a href={withBase("/lectures/week-03/")}>Week 3</a> lectures; the Alignment
    Lab spans Weeks 9 to 11 and is assessed separately — see the{" "}
    <a href={withBase("/alignment-lab/")}>Alignment Lab</a> page for how its
    own schedule fits inside those three sessions.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="The Alignment Lab" href="/alignment-lab/">
      <p>How the course's four-role decision simulation runs, and a worked example.</p>
    </Card>
    <Card title="Templates" href="/templates/">
      <p>The strategy memo, negotiation log, agenda and decision-record formats.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .week-table {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1rem;
  }

  .week-table th,
  .week-table td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--at-border);
    text-align: left;
    vertical-align: top;
  }

  .week-table td:first-child {
    width: 3rem;
    color: var(--at-text-secondary);
  }

  .week-table-note {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }
</style>
